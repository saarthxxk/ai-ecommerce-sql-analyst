# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# The application connects with a READ-ONLY role. Nothing in the API can write.
DATABASE_URL=postgresql+psycopg://analyst_ro:analyst_ro_pw@localhost:5432/ecommerce_analyst

# Used by scripts/load_data.py only (needs to CREATE/COPY). Keep it out of the API.
ADMIN_DATABASE_URL=postgresql+psycopg://analyst_owner:analyst_owner_pw@localhost:5432/ecommerce_analyst

# Superuser password, used ONCE by `python scripts/load_data.py --bootstrap`
# to create the database and the two roles. Safe to delete afterwards.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=
PG_HOST=localhost
PG_PORT=5432

# Passwords assigned to the roles created during bootstrap.
ANALYST_OWNER_PASSWORD=analyst_owner_pw
ANALYST_RO_PASSWORD=analyst_ro_pw

# --- LLM provider ---------------------------------------------------------
# One of: gemini | vertexai | openai | fake
#   gemini   -> Google AI Studio API key (simplest)
#   vertexai -> Google Cloud Vertex AI (uses ADC / service account)
#   openai   -> OpenAI-compatible endpoint
#   fake     -> deterministic offline stub, used by the test suite (no key needed)
LLM_PROVIDER=gemini

# gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# vertexai (only needed when LLM_PROVIDER=vertexai)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# openai (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Behaviour ------------------------------------------------------------
# Where the source CSVs live (read by scripts/load_data.py).
DATA_DIR=ecommerce_dataset

# Hard cap on rows returned from a generated query.
MAX_RESULT_ROWS=500

# PostgreSQL statement_timeout applied to every analyst query (milliseconds).
STATEMENT_TIMEOUT_MS=15000

# Temperature for SQL generation. Keep low for deterministic SQL.
LLM_TEMPERATURE=0.0
